---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'HTML Sitemaps', url: '/sitemaps' }
];

const posts = await getCollection('blog');
---

<PageLayout
  title="HTML Sitemaps - All Pages & Directory | YouTube to MP4"
  description="Comprehensive index and directory of all conversion tools, guides, legal notices, and technical documentation on YouTube to MP4."
  breadcrumbs={breadcrumbs}
  canonical="https://ytubeconvert.com/sitemaps"
>
  <h1>HTML Sitemaps Directory</h1>
  <p>Explore all available conversion tools, technical tutorials, and policy documents available across YouTube to MP4.</p>

  <div class="responsive-card-grid">
    <div class="step-card">
      <h3>Core Conversion Tools</h3>
      <ul style="margin-left: 1.25rem; margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <li><a href="/" style="color:var(--accent); text-decoration:underline;">YouTube to MP4 Homepage</a></li>
        <li><a href="/youtube-to-mp4-converter" style="color:var(--accent); text-decoration:underline;">YouTube to MP4 Converter</a></li>
        <li><a href="/yt-mp3-converter" style="color:var(--accent); text-decoration:underline;">YT MP3 Converter</a></li>
        <li><a href="/youtube-to-mp4-downloader" style="color:var(--accent); text-decoration:underline;">YouTube to MP4 Downloader</a></li>
        <li><a href="/youtube-to-mp4-1080p" style="color:var(--accent); text-decoration:underline;">YouTube to MP4 1080p</a></li>
        <li><a href="/youtube-to-mp4-4k" style="color:var(--accent); text-decoration:underline;">YouTube to MP4 4K</a></li>
        <li><a href="/convert-youtube-to-mp4" style="color:var(--accent); text-decoration:underline;">Convert YouTube to MP4</a></li>
        <li><a href="/youtube-to-mp4-player" style="color:var(--accent); text-decoration:underline;">YouTube to MP4 Player</a></li>
      </ul>
    </div>

    <div class="step-card">
      <h3>Guides & Technical Articles</h3>
      <ul style="margin-left: 1.25rem; margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <li><a href="/blog" style="color:var(--accent); text-decoration:underline;">Blog Directory</a></li>
        <li><a href="/how-to-use" style="color:var(--accent); text-decoration:underline;">How to Use Guide</a></li>
        <li><a href="/faq" style="color:var(--accent); text-decoration:underline;">Frequently Asked Questions (FAQ)</a></li>
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.slug}`} style="color:var(--accent); text-decoration:underline;">
              {p.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="step-card">
      <h3>Legal, Privacy & Compliance</h3>
      <ul style="margin-left: 1.25rem; margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <li><a href="/about" style="color:var(--accent); text-decoration:underline;">About Us</a></li>
        <li><a href="/contact" style="color:var(--accent); text-decoration:underline;">Contact Support</a></li>
        <li><a href="/dmca" style="color:var(--accent); text-decoration:underline;">DMCA Copyright Policy</a></li>
        <li><a href="/privacy-policy" style="color:var(--accent); text-decoration:underline;">Privacy Policy</a></li>
        <li><a href="/terms-of-service" style="color:var(--accent); text-decoration:underline;">Terms of Service</a></li>
        <li><a href="/cookie-policy" style="color:var(--accent); text-decoration:underline;">Cookie Policy</a></li>
        <li><a href="/disclaimer" style="color:var(--accent); text-decoration:underline;">Legal Disclaimer</a></li>
        <li><a href="/sitemap.xml" style="color:var(--accent); text-decoration:underline;">XML Sitemap (Direct)</a></li>
        <li><a href="/sitemap-index.xml" style="color:var(--accent); text-decoration:underline;">XML Sitemap Index</a></li>
        <li><a href="/llms" style="color:var(--accent); text-decoration:underline;">LLMs Context Specification</a></li>
        <li><a href="/llms.txt" style="color:var(--accent); text-decoration:underline;">LLMs Text Manifest (/llms.txt)</a></li>
      </ul>
    </div>
  </div>
</PageLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import { useTranslations, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const locales: SupportedLanguage[] = [
    'es', 'hi', 'pt', 'fr', 'de', 'id', 'ar', 'ru', 'ja', 'tr', 'it', 'ko', 'vi'
  ];
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);

const breadcrumbs = [
  { name: t('nav_home'), url: `/${lang}` },
  { name: t('nav_faq'), url: `/${lang}/faq` }
];

const faqs: FaqItem[] = [
  {
    question: t('how_it_works_title'),
    answer: `${t('step_1_desc')} ${t('step_2_desc')} ${t('step_3_desc')}`
  },
  {
    question: t('feature_1_title'),
    answer: t('feature_1_desc')
  },
  {
    question: t('feature_2_title'),
    answer: t('feature_2_desc')
  },
  {
    question: t('feature_3_title'),
    answer: t('feature_3_desc')
  },
  {
    question: t('feature_6_title'),
    answer: t('feature_6_desc')
  }
];
---

<BaseLayout
  title={`${t('nav_faq')} - ${t('site_title')}`}
  description={t('site_description')}
  lang={lang}
  canonical={`https://youtubetomp4.org/${lang}/faq`}
>
  <Breadcrumbs items={breadcrumbs} />
  <div class="container content-section" style="padding-top: 1rem;">
    <FaqAccordion items={faqs} title={t('nav_faq')} subtitle={t('hero_subtitle')} />
  </div>
</BaseLayout>

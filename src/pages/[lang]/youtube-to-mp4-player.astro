---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import ConverterWidget from '../../components/ConverterWidget.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { useTranslations, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const locales: SupportedLanguage[] = [
    'es', 'hi', 'pt', 'fr', 'de', 'id', 'ar', 'ru', 'ja', 'tr', 'it', 'ko', 'vi'
  ];
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);

const breadcrumbs = [
  { name: t('nav_home'), url: `/${lang}` },
  { name: `${t('hero_title_prefix')} ${t('nav_player')}`, url: `/${lang}/youtube-to-mp4-player` }
];

const faqs: FaqItem[] = [
  {
    question: t('player_title'),
    answer: t('player_subtitle')
  },
  {
    question: t('feature_3_title'),
    answer: t('feature_3_desc')
  }
];
---

<BaseLayout
  title={`${t('hero_title_prefix')} ${t('nav_player')} - ${t('site_title')}`}
  description={t('site_description')}
  lang={lang}
  canonical={`https://youtubetomp4.org/${lang}/youtube-to-mp4-player`}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="container" style="text-align: center; padding: 2rem 1.25rem 1rem;">
    <h1 class="hero-title">
      {t('hero_title_prefix')} <span class="hero-gradient-text">{t('nav_player')}</span>
    </h1>
    <p class="hero-subtitle">
      {t('player_subtitle')}
    </p>

    <div style="max-width: 820px; margin: 0 auto 3rem;">
      <ConverterWidget lang={lang} defaultQuality="1080p" />
    </div>
  </section>

  <VideoPlayer lang={lang} />

  <section class="container content-section">
    <h2>{t('player_title')}</h2>
    <p>
      {t('player_subtitle')}
    </p>
    <ul>
      <li><strong>{t('feature_3_title')}:</strong> {t('feature_3_desc')}</li>
      <li><strong>{t('feature_1_title')}:</strong> {t('feature_1_desc')}</li>
      <li><strong>{t('feature_6_title')}:</strong> {t('feature_6_desc')}</li>
    </ul>
  </section>

  <FeatureCards lang={lang} />
  <FaqAccordion items={faqs} title={t('nav_faq')} />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { useTranslations, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const locales: SupportedLanguage[] = [
    'es', 'hi', 'pt', 'fr', 'de', 'id', 'ar', 'ru', 'ja', 'tr', 'it', 'ko', 'vi'
  ];
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);

const breadcrumbs = [
  { name: t('nav_home'), url: `/${lang}` },
  { name: t('site_title'), url: `/${lang}/convert-youtube-to-mp4` }
];

const faqs: FaqItem[] = [
  {
    question: t('how_it_works_title'),
    answer: `${t('step_1_desc')} ${t('step_2_desc')} ${t('step_3_desc')}`
  },
  {
    question: t('feature_1_title'),
    answer: t('feature_1_desc')
  },
  {
    question: t('feature_4_title'),
    answer: t('feature_4_desc')
  }
];
---

<BaseLayout
  title={`${t('site_title')}`}
  description={t('site_description')}
  lang={lang}
  canonical={`https://youtubetomp4.org/${lang}/convert-youtube-to-mp4`}
>
  <Breadcrumbs items={breadcrumbs} />
  <Hero lang={lang} h1Title={t('hero_title_prefix')} defaultQuality="1080p" />
  <HowItWorks lang={lang} />
  <VideoPlayer lang={lang} />
  <FeatureCards lang={lang} />

  <section class="container content-section">
    <h2>{t('features_title')}</h2>
    <p>
      {t('hero_subtitle')}
    </p>
    <ul>
      <li><strong>{t('feature_1_title')}:</strong> {t('feature_1_desc')}</li>
      <li><strong>{t('feature_4_title')}:</strong> {t('feature_4_desc')}</li>
      <li><strong>{t('trust_free')}:</strong> {t('feature_5_desc')}</li>
    </ul>
  </section>

  <FaqAccordion items={faqs} title={t('nav_faq')} />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import { useTranslations, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const locales: SupportedLanguage[] = [
    'es', 'hi', 'pt', 'fr', 'de', 'id', 'ar', 'ru', 'ja', 'tr', 'it', 'ko', 'vi'
  ];
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);

const faqs: FaqItem[] = [
  {
    question: t('how_it_works_title'),
    answer: `${t('step_1_desc')} ${t('step_2_desc')} ${t('step_3_desc')}`
  },
  {
    question: t('features_title'),
    answer: `${t('feature_1_title')}: ${t('feature_1_desc')}. ${t('feature_2_title')}: ${t('feature_2_desc')}. ${t('feature_6_title')}: ${t('feature_6_desc')}`
  }
];
---

<BaseLayout
  title={t('site_title')}
  description={t('site_description')}
  lang={lang}
  canonical={`https://ytubeconvert.com/${lang}`}
>
  <Hero lang={lang} h1Title={t('hero_title_prefix')} defaultQuality="1080p" />
  <HowItWorks lang={lang} />
  <VideoPlayer lang={lang} />
  <FeatureCards lang={lang} />
  <FaqAccordion items={faqs} title={t('nav_faq')} />
</BaseLayout>

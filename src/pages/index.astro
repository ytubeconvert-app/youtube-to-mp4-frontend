---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeatureCards from '../components/FeatureCards.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import FaqAccordion, { type FaqItem } from '../components/FaqAccordion.astro';
import AdSlot from '../components/AdSlot.astro';

const homeFaqs: FaqItem[] = [
  {
    question: "What is the best way to convert YouTube to MP4 in 1080p without losing quality?",
    answer: "Our web-based YouTube to MP4 converter extracts direct video and high-bitrate AAC audio streams directly from YouTube's media servers, multiplexing them with FFmpeg into an industry-standard H.264 MP4 container. This eliminates re-compression artifacts, ensuring your 1080p and 4K downloads remain pin-sharp."
  },
  {
    question: "Is it legal to convert YouTube to MP4?",
    answer: "Yes, converting YouTube videos is completely legal provided you download content that you personally created and own, content that is in the public domain, or videos published under an open Creative Commons (CC-BY) license. You must never download commercial copyright-protected material or bypass digital rights management (DRM) technologies."
  },
  {
    question: "Can I preview the video before downloading it to my computer or phone?",
    answer: "Yes! Unlike other conversion sites, we feature an integrated YouTube to MP4 player right on this page. Once conversion completes, you can hit 'Preview in Video Player Below' to verify full audio-video synchronization before initiating the file download."
  },
  {
    question: "Do I need to install any software or browser extensions?",
    answer: "No. The entire conversion process runs on our scalable cloud infrastructure. You only need a modern web browser like Google Chrome, Apple Safari, Mozilla Firefox, or Microsoft Edge. No executable files, adware, or plugins are ever required."
  },
  {
    question: "Why do some converted videos have no sound on older converters?",
    answer: "YouTube stores 1080p and 4K video streams separately from audio streams using dynamic adaptive streaming (DASH). Basic downloaders only pull the silent video track. Our service automatically merges the separate high-fidelity audio track into the MP4 file before delivering it to you, guaranteeing crystal-clear sound."
  }
];

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [

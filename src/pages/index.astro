      "url": "https://ytubeconvert.com",
      "description": "Convert YouTube to MP4 in high-definition 1080p and 4K quality online.",
      "publisher": {
        "@id": "https://ytubeconvert.com/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://ytubeconvert.com/convert-youtube-to-mp4?url={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://ytubeconvert.com/#organization",
      "name": "YouTube to MP4",
      "url": "https://ytubeconvert.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://ytubeconvert.com/favicon.svg"
      },
      "founder": {
        "@id": "https://ytubeconvert.com/#author"
      }
    },
    {
      "@type": "Person",
      "@id": "https://ytubeconvert.com/#author",
      "name": "Kamlesh Mohabe",
      "jobTitle": "Lead Multimedia Software Engineer",
      "url": "https://ytubeconvert.com/about",
      "sameAs": [
        "https://github.com/ytubeconvert"
      ]
    },
    {
      "@type": "WebApplication",
      "@id": "https://ytubeconvert.com/#webapp",
      "name": "Convert YouTube to MP4",
      "url": "https://ytubeconvert.com",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "All (Web Browser, Windows, macOS, Android, iOS, Linux)",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@id": "https://ytubeconvert.com/#author"
      },
      "creator": {
        "@id": "https://ytubeconvert.com/#author"
      },
      "description": "Free online video converter to convert YouTube to MP4 in 1080p Full HD and 4K Ultra HD quality with an integrated video preview player."
    },
    {
      "@type": "FAQPage",
      "@id": "https://ytubeconvert.com/#faq",
      "mainEntity": homeFaqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",

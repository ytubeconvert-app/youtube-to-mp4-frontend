---
import PageLayout from '../layouts/PageLayout.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ConverterWidget from '../components/ConverterWidget.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'How to Use', url: '/how-to-use' }
];

const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Convert YouTube to MP4",
  "description": "Step-by-step instructions on converting permitted YouTube video streams into MP4 format in 1080p or 4K.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Copy the YouTube Video Link",
      "text": "Navigate to the authorized YouTube video and copy the URL from your browser address bar or through the YouTube Share button."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Paste URL & Choose Resolution",
      "text": "Paste the copied URL into the converter input bar on YouTube to MP4, review video duration, and pick 720p, 1080p, or 4K."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Convert & Download",
      "text": "Click Convert, wait a few seconds for the cloud multiplexer to finalize the file, test playback in the built-in player, and click Download MP4."
    }
  ]
};
---

<PageLayout
  title="How to Use YouTube to MP4 - Step-by-Step Tutorial"
  description="Learn how to convert YouTube to MP4 in 1080p and 4K with our easy 3-step walkthrough and troubleshooting guide."
  breadcrumbs={breadcrumbs}
  canonical="https://ytubeconvert.com/how-to-use"
  jsonLd={howToJsonLd}
>
  <h1>How to Use the YouTube to MP4 Converter</h1>
  <p>
    Converting video streams into high-definition, universally compatible MP4 files on our platform takes only a few seconds. Follow this comprehensive guide to get optimal audio and video results every time.
  </p>

  <div style="max-width: 820px; margin: 2rem auto;">
    <ConverterWidget defaultQuality="1080p" />
  </div>

  <HowItWorks />

  <h2>Detailed Walkthrough</h2>

  <h3>Step 1: Obtain the Verified Source URL</h3>
  <p>
    Open YouTube on your computer or mobile device. Go to the video you have rights or permission to save.
  </p>
  <ul>
    <li><strong>On Desktop:</strong> Highlight the URL in your browser bar (e.g., <code>https://www.youtube.com/watch?v=...</code>) and press <code>Ctrl+C</code> (Windows) or <code>Cmd+C</code> (Mac).</li>
    <li><strong>On Mobile App:</strong> Tap the <em>Share</em> button located directly underneath the video player, then tap <em>Copy Link</em>.</li>
  </ul>

  <h3>Step 2: Paste and Select Your Output Profile</h3>
  <p>
    Return to our homepage and paste the link into the converter box. You can simply tap the <strong>Paste</strong> button. Click <strong>Convert</strong>. Our cloud engine will inspect the video metadata and display:
  </p>
  <ul>
    <li>The video thumbnail and verified creator channel name.</li>
    <li>Total runtime duration.</li>
    <li>Available output resolutions: <strong>720p HD</strong>, <strong>1080p Full HD</strong>, <strong>4K Ultra HD</strong>, or <strong>MP3 Audio</strong>.</li>
  </ul>

  <h3>Step 3: Preview and Save</h3>
  <p>
    Once you click your preferred quality profile, our cloud pipeline packages the video. Once complete:
  </p>
  <ul>
    <li>Click <strong>Download MP4</strong> to save the file directly to your device storage.</li>
    <li>Or click <strong>Preview in Video Player Below</strong> to watch the file and verify audio/video synchronicity right in the browser!</li>
  </ul>
</PageLayout>

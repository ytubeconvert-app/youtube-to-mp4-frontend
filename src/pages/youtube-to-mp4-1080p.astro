---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeatureCards from '../components/FeatureCards.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import FaqAccordion, { type FaqItem } from '../components/FaqAccordion.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'YouTube to MP4 1080p', url: '/youtube-to-mp4-1080p' }
];

const faqs: FaqItem[] = [
  {
    question: "Why do some converters cap video at 720p instead of true 1080p?",
    answer: "YouTube delivers 720p as a pre-merged progressive stream, whereas 1080p requires separate video and audio stream extraction followed by server-side FFmpeg multiplexing. Many low-budget conversion sites lack the computing infrastructure to handle multiplexing at scale and secretly downgrade users to 720p. Our service deploys high-performance cloud clusters to deliver true 1920x1080 Full HD without downscaling."
  },
  {
    question: "Does your 1080p converter support 60 frames per second (1080p60)?",
    answer: "Yes! If the source video was captured and uploaded in 1080p at 60 fps (common in gaming playthroughs, sports broadcasts, and high-motion drone aerials), our converter preserves the complete 60fps frame sequence, maintaining maximum temporal motion smoothness."
  },
  {
    question: "What is the typical file size of a 1080p MP4 download?",
    answer: "At typical YouTube H.264 bitrates (3,500 kbps to 6,000 kbps), a 5-minute video will measure approximately 150MB to 250MB, a 10-minute video will average 350MB to 500MB, and a 60-minute full lecture will range between 1.8GB and 2.5GB."
  },
  {
    question: "Will a 1080p MP4 file play smoothly on older laptops or budget tablets?",
    answer: "Yes. 1080p H.264 video with AAC audio is the most universally accelerated video profile in electronic history. Every PC, Mac, iPad, iPhone, and Android smartphone produced in the last 12 years possesses dedicated silicon hardware decoders that play 1080p MP4 with near-zero CPU strain."
  },
  {
    question: "Can I convert YouTube Shorts into 1080p vertical video?",
    answer: "Yes. YouTube Shorts uploaded in high resolution are preserved in true 1080x1920 Full HD vertical format, ideal for mobile offline editing in CapCut, Instagram Reels, or TikTok."
  },
  {
    question: "How do I verify that my downloaded file is genuine 1080p and not upscaled 720p?",
    answer: "On Windows, right-click the downloaded MP4, select 'Properties', and view the 'Details' tab—it will read 'Frame width: 1920' and 'Frame height: 1080'. On macOS, open the file in QuickTime Player and press Command+I to inspect the native resolution."
  }
];

---
import { useTranslations, type SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="container" style="padding-top: clamp(1.5rem, 4vw, 2.5rem); padding-bottom: clamp(2.5rem, 6vw, 4rem);">
  <div style="text-align: center; margin-bottom: clamp(1.5rem, 4vw, 2.5rem);">
    <h2 class="section-title">{t('features_title')}</h2>
    <p class="section-subtitle">Engineered for speed, fidelity, and bulletproof user privacy.</p>
  </div>

  <div class="features-grid">
    <div class="feature-card">
      <div class="feature-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <div>
        <h3>{t('feature_1_title')}</h3>
        <p>{t('feature_1_desc')}</p>
      </div>
    </div>

    <div class="feature-card">
      <div class="feature-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      </div>
      <div>
        <h3>{t('feature_2_title')}</h3>
        <p>{t('feature_2_desc')}</p>
      </div>
    </div>

    <div class="feature-card">
      <div class="feature-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="10 8 16 12 10 16 10 8"></polygon>
        </svg>
      </div>
      <div>
        <h3>{t('feature_3_title')}</h3>
        <p>{t('feature_3_desc')}</p>
      </div>
    </div>

    <div class="feature-card">
      <div class="feature-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <line x1="18" y1="8" x2="23" y2="13"></line>
          <line x1="23" y1="8" x2="18" y2="13"></line>
        </svg>
      </div>
      <div>
        <h3>{t('feature_4_title')}</h3>
        <p>{t('feature_4_desc')}</p>
      </div>
    </div>

    <div class="feature-card">
      <div class="feature-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
      </div>
      <div>
        <h3>{t('feature_5_title')}</h3>
        <p>{t('feature_5_desc')}</p>
      </div>
    </div>

    <div class="feature-card">
      <div class="feature-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      </div>
      <div>
        <h3>{t('feature_6_title')}</h3>
        <p>{t('feature_6_desc')}</p>
      </div>
    </div>
  </div>
</section>

---
import { useTranslations, type SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="player-section" id="player-preview-section">
  <div class="container">
    <h2 class="section-title">{t('player_title')}</h2>
    <p class="section-subtitle">{t('player_subtitle')}</p>

    <div class="player-box">
      <div class="video-container">
        <video
          id="preview-video"
          controls
          preload="metadata"
          playsinline
          aria-label="YouTube to MP4 Player Preview"
        >
          <p>Your browser does not support HTML5 video playback.</p>
        </video>
      </div>

      <div class="player-controls-meta">
        <div>
          <strong id="player-video-title" style="display:block; font-size:1rem; margin-bottom:0.25rem;">
            No video loaded yet
          </strong>
          <small style="color:var(--text-muted)">
            Convert a video above or test playback directly in the integrated YouTube to MP4 player.
          </small>
        </div>
        <div style="display:flex; gap:0.5rem;">
          <button
            type="button"
            id="player-fullscreen-btn"
            class="quality-btn"
            style="padding:0.4rem 0.8rem; font-size:0.8rem;"
            aria-label="Toggle Fullscreen"
          >
            Fullscreen
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const fsBtn = document.getElementById('player-fullscreen-btn');
  const videoEl = document.getElementById('preview-video');
  if (fsBtn && videoEl) {
    fsBtn.addEventListener('click', () => {
      if (videoEl.requestFullscreen) {
        videoEl.requestFullscreen();
      } else if (videoEl.webkitRequestFullscreen) {
        videoEl.webkitRequestFullscreen();
      }
    });
  }
</script>

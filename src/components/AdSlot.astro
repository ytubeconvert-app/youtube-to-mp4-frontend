---
interface Props {
  slotType: 'leaderboard' | 'rectangle' | 'responsive';
  adSlotId?: string;
}

const { slotType, adSlotId = '1234567890' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || 'ca-pub-0000000000000000';
---

<div class="ad-slot-container" aria-label="Sponsored Content">
  <span class="ad-label">Advertisement</span>
  <div class={`ad-slot ad-slot-${slotType}`}>
    <!-- Dynamic AdSense tag activated only after consent -->
    <ins
      class="adsbygoogle"
      style="display:block; width:100%; height:100%;"
      data-ad-client={client}
      data-ad-slot={adSlotId}
      data-ad-format={slotType === 'responsive' ? 'auto' : undefined}
      data-full-width-responsive="true"
    ></ins>
  </div>
</div>
